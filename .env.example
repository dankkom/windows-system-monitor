# Copie para .env: copy .env.example .env
# Ajuste DATABASE_URL com sua senha do postgres (pgpass.conf)

DATABASE_URL=postgresql://postgres:22932293@localhost:5432/system_monitor
HOSTNAME=

# Intervalos em segundos (ajuste conforme carga vs granularidade)
INTERVAL_CPU=10
INTERVAL_MEMORY=10
INTERVAL_DISK_IO=10
INTERVAL_DISK_USAGE=60
INTERVAL_DISK_PHYSICAL=300
INTERVAL_DISK_SMART=300
INTERVAL_NETWORK=10
INTERVAL_GPU=10
INTERVAL_SENSORS=15
INTERVAL_PROCESSES=30
INTERVAL_CONNECTIONS=30
INTERVAL_SERVICES=60
INTERVAL_SYSTEM=60
INTERVAL_EVENTLOG=60

# Coleta de processos
TOP_PROCESSES=50

# Log
LOG_LEVEL=INFO

# Retenção: false = histórico permanente (padrão). true = ativa limpeza periódica via jobs/retention.py
ENABLE_RETENTION=false
RETENTION_PROCESSES=30 days
RETENTION_CONNECTIONS=7 days
RETENTION_SENSORS=90 days
RETENTION_CPU=90 days
RETENTION_MEMORY=90 days
RETENTION_GPU=90 days
RETENTION_HEARTBEAT=30 days
RETENTION_EVENTLOG=30 days
RETENTION_DISK_IO=90 days
RETENTION_NET_IO=90 days

# Dashboard
DASHBOARD_PORT=8501
